<page route="/base/countries" title="%countries%" model="country">
  <view type="list" model="country" source="list_countries" open="/base/countries/{id}" create="/base/countries/new" create_label="%add_country%">
    <search/>
    <columns>
      <column field="code" label="%code%"/>
      <column field="name" label="%name%"/>
      <column field="phone_prefix" label="%phone%"/>
      <column field="active" label="%active%" fieldType="boolean"/>
    </columns>
    <empty title="%no_countries_yet%" description="%use_new_to_add%"/>
  </view>
</page>
