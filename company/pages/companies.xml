<page route="/base/companies" title="%companies%" model="company" icon="building-2">
  <view type="list" model="company" source="list_companies" open="/base/companies/{id}" create="/base/companies/new" create_label="%add_company%">
    <search fields="name"/>
    <use component="base_ui.active_filter" field="is_active" label="%active%"/>
    <columns>
      <column field="logo" label="%logo%" fieldType="avatar"/>
      <column field="name" label="%name%"/>
      <column field="is_default" label="%default%" fieldType="boolean"/>
      <column field="is_active" label="%active%" fieldType="boolean"/>
    </columns>
    <actions>
      <action name="default" label="%make_default%" function="set_default_company" disabled_when="is_default,!is_active"/>
      <action name="archive" label="%archive%" function="archive_company" confirm="%archive_this_company%" danger="true" disabled_when="is_default,!is_active"/>
    </actions>
    <use component="base_ui.empty_state" title="%no_company_yet%" description="%use_new_to_add%"/>
  </view>
</page>
