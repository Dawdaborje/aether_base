<page route="/base/sequences" title="%sequences%" model="number_sequence" icon="hash">
  <view type="list" model="number_sequence" source="list_sequences" create="/base/sequences/new" create_label="%add_sequence%">
    <search fields="code,name,prefix"/>
    <columns>
      <column field="code" label="%code%"/>
      <column field="label" label="%label%"/>
      <column field="prefix" label="%prefix%"/>
      <column field="reset" label="%reset%"/>
      <column field="gapless" label="%gapless%" fieldType="boolean"/>
    </columns>
    <empty title="%no_sequence_yet%" description="%use_new_to_add%"/>
  </view>
</page>
