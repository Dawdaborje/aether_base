<page route="/base/activities" title="Activities" model="base.mail_activity">
  <include src="base_components/components/header.xml" title="Activities" />
  <view type="list" model="base.mail_activity">
    <search placeholder="Search activities…" />
    <columns>
      <column field="summary" label="Summary" sortable="true" />
      <column field="model" label="Model" />
      <column field="activity_type" label="Type" fieldType="badge" />
      <column field="deadline" label="Deadline" fieldType="datetime" />
      <column field="done" label="Done" fieldType="boolean" />
    </columns>
    <empty title="No activities" description="Schedule follow-ups from any record chatter." />
  </view>
</page>
