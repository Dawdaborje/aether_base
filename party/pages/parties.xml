<page route="/base/parties" title="%parties%" model="party">
  <view type="list" model="party" source="list_parties" open="/base/parties/{id}" create="/base/parties/new" create_label="%add_person%">
    <search/>
    <columns>
      <column field="display_name" label="%name%"/>
      <column field="kind" label="%kind%" fieldType="badge"/>
      <column field="email" label="%email%"/>
      <column field="phone" label="%phone%"/>
      <column field="is_customer" label="%customer%" fieldType="boolean"/>
      <column field="is_supplier" label="%supplier%" fieldType="boolean"/>
    </columns>
    <actions>
      <action name="archive" label="%archive%" function="archive" confirm="%archive_this_party%" danger="true"/>
    </actions>
    <empty title="%no_parties_yet%" description="%use_new_to_add%"/>
  </view>
</page>
