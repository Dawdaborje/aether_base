<page route="/base/parties/new-organization" title="%new_organization%" model="party" icon="building">
  <view type="form" function="create_organization" submit="%add_organization%" success="%organization_added%" redirect="/base/parties">
    <field name="name" label="%legal_name%" required="true"/>
    <field name="tax_id" label="%tax_or_registration_number%"/>
    <use component="base_ui.contact_group" title="%contact%"
         email="email" email_label="%email%" phone="phone" phone_label="%phone%">
      <field name="website" label="%website%"/>
    </use>
    <use component="base_ui.currency_link" name="currency_code" label="%currency_code%"/>
    <field name="is_customer" label="%customer%" fieldType="boolean"/>
    <field name="is_supplier" label="%supplier%" fieldType="boolean"/>
    <field name="is_bank" label="%bank%" fieldType="boolean"/>
  </view>
</page>
