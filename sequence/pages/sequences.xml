<page route="/base/sequences" title="Sequences" model="base.sequence">
  <include src="base_components/components/header.xml" title="Sequences" />
  <view type="list" model="base.sequence">
    <search placeholder="Search sequences…" />
    <columns>
      <column field="name" label="Name" sortable="true" />
      <column field="code" label="Code" />
      <column field="prefix" label="Prefix" />
      <column field="next_number" label="Next" fieldType="integer" />
      <column field="padding" label="Padding" fieldType="integer" />
    </columns>
    <empty title="No sequences" description="Create a sequence for invoices, orders, or tickets." actionLabel="Create" />
  </view>
</page>
