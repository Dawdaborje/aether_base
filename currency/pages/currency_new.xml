<page route="/base/currencies/new" title="%add_currency%" model="currency">
  <view type="form" function="create_currency" submit="%add_currency%" success="%currency_added%" redirect="/base/currencies">
    <field name="code" label="%code%" required="true"/>
    <field name="name" label="%name%" required="true"/>
    <field name="symbol" label="%symbol%"/>
    <field name="decimal_places" label="%decimal_places%" fieldType="integer"/>
  </view>
</page>
