<page route="/base/currencies" title="%currencies%" model="currency">
  <view type="form" function="create_currency" submit="%add_currency%" success="%currency_added%">
    <field name="code" label="%code%" required="true"/>
    <field name="name" label="%name%" required="true"/>
    <field name="symbol" label="%symbol%"/>
    <field name="decimal_places" label="%decimal_places%" fieldType="integer"/>
  </view>
  <view type="list" model="currency" source="list_currencies" open="/base/currencies/{id}">
    <search/>
    <columns>
      <column field="code" label="%code%"/>
      <column field="name" label="%name%"/>
      <column field="symbol" label="%symbol%"/>
      <column field="is_base" label="%base%" fieldType="boolean"/>
      <column field="active" label="%active%" fieldType="boolean"/>
    </columns>
    <empty title="%no_currencies_yet%" description="%seed_hint.currency%"/>
  </view>
</page>
