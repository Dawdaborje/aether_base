<page route="/base/currencies" title="%currencies%" model="currency" icon="banknote">
  <view type="list" model="currency" source="list_currencies" open="/base/currencies/{id}" create="/base/currencies/new" create_label="%add_currency%">
    <search fields="code,name,symbol"/>
    <filter field="active" label="%active%" options="Active=true,Inactive=false"/>
    <columns>
      <column field="code" label="%code%"/>
      <column field="name" label="%name%"/>
      <column field="symbol" label="%symbol%"/>
      <column field="is_base" label="%base%" fieldType="boolean"/>
      <column field="active" label="%active%" fieldType="boolean"/>
    </columns>
    <empty title="%no_currencies_yet%" description="%use_new_to_add%"/>
  </view>
</page>
