<page route="/base/currencies" title="Currencies" model="base.currency">
  <include src="base_components/components/header.xml" title="Currencies" />
  <view type="list" model="base.currency">
    <search placeholder="Search currencies…" />
    <columns>
      <column field="name" label="Name" sortable="true" />
      <column field="code" label="Code" />
      <column field="symbol" label="Symbol" />
      <column field="decimal_places" label="Decimals" fieldType="integer" />
      <column field="is_base" label="Base" fieldType="boolean" />
    </columns>
    <empty title="No currencies" description="Add currencies used on invoices and orders." actionLabel="Create" />
  </view>
</page>
