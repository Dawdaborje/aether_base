<page route="/base/calendars" title="Holiday calendars" model="holiday_calendar" icon="calendar-days">
  <view type="list" model="holiday_calendar" source="list_calendars" create="/base/calendars/new" create_label="New">
    <search fields="name,weekend"/>
    <use component="base_ui.active_filter" field="is_active" label="Active"/>
    <columns>
      <column field="name" label="Name"/>
      <column field="weekend" label="Days off"/>
      <column field="is_active" label="Active" fieldType="boolean"/>
    </columns>
    <use component="base_ui.empty_state" title="No calendars yet" description="Use New to add one."/>
  </view>
</page>
