<page route="/base/partners" title="Contacts" model="base.partner">
  <include src="base_components/components/header.xml" title="Contacts" />
  <view type="list" model="base.partner">
    <search placeholder="Search contacts…" />
    <columns>
      <column field="name" label="Name" sortable="true" />
      <column field="email" label="Email" />
      <column field="phone" label="Phone" />
      <column field="is_company" label="Company" fieldType="boolean" />
      <column field="is_customer" label="Customer" fieldType="boolean" />
      <column field="is_vendor" label="Vendor" fieldType="boolean" />
    </columns>
    <actions>
      <action name="open" label="Open" />
      <action name="archive" label="Archive" confirm="true" />
    </actions>
    <empty title="No contacts yet" description="Add a customer, vendor, or person." actionLabel="Create contact" />
  </view>
  <include src="base_components/components/modal_form.xml" name="create_partner" title="New contact" />
</page>
