<page route="/base/partners/form" title="Partner" model="base.partner">
  <include src="base_components/components/statusbar.xml" />
  <view type="form" model="base.partner">
    <group title="Identity">
      <field name="name" label="Name" fieldType="char" required="true" />
      <field name="is_company" label="Is a company" fieldType="boolean" />
      <field name="email" label="Email" fieldType="char" />
      <field name="phone" label="Phone" fieldType="char" />
      <field name="mobile" label="Mobile" fieldType="char" />
      <field name="vat" label="Tax ID" fieldType="char" />
    </group>
    <group title="Roles">
      <field name="is_customer" label="Customer" fieldType="boolean" />
      <field name="is_vendor" label="Vendor" fieldType="boolean" />
    </group>
    <group title="Address">
      <field name="street" label="Street" fieldType="char" />
      <field name="city" label="City" fieldType="char" />
      <field name="state" label="State" fieldType="char" />
      <field name="zip" label="ZIP" fieldType="char" />
      <field name="country_code" label="Country" fieldType="char" />
    </group>
    <group title="Notes">
      <field name="notes" label="Notes" fieldType="text" />
    </group>
    <!-- Future: embed mail chatter component -->
    <include src="mail/components/chatter.xml" />
    <buttonbox>
      <button name="save" label="Save" />
      <button name="discard" label="Discard" variant="outline" />
    </buttonbox>
  </view>
</page>
