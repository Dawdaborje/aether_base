<!-- Standard form sheet: group of fields + save/discard buttonbox. -->
<view type="form" model="{{model}}">
  <group title="{{group_title}}">
    <!-- consumer inserts <field …/> children -->
  </group>
  <buttonbox>
    <button name="save" label="Save" />
    <button name="discard" label="Discard" variant="outline" />
  </buttonbox>
</view>
